page {
    background: #f7f3ec;
    color: #1f2420;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    font-size: 28rpx;
}

view,
text,
button,
input,
textarea {
    box-sizing: border-box;
}

button {
    border: 0;
    border-radius: 999rpx;
    font-size: 28rpx;
    line-height: 1;
}

button::after {
    border: 0;
}

.page {
    min-height: 100vh;
    padding: 24rpx;
    padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.section {
    margin-top: 32rpx;
}

.section-title {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 18rpx;
}

.section-title-main {
    font-size: 36rpx;
    font-weight: 700;
    color: #1f2420;
}

.section-title-sub {
    font-size: 24rpx;
    color: #6f746f;
}

.card {
    background: #fffcf7;
    border: 1rpx solid #e7ded2;
    border-radius: 16rpx;
    box-shadow: 0 16rpx 40rpx rgba(58, 49, 38, 0.06);
}

.primary-button {
    min-height: 88rpx;
    padding: 0 34rpx;
    background: #3f6f5a;
    color: #ffffff;
    font-weight: 700;
}

.secondary-button {
    min-height: 88rpx;
    padding: 0 34rpx;
    background: #fff8ea;
    color: #3f4c42;
    border: 1rpx solid #eadbc2;
    font-weight: 700;
}

.tag {
    display: inline-flex;
    align-items: center;
    min-height: 40rpx;
    padding: 0 16rpx;
    border-radius: 999rpx;
    background: #edf3ee;
    color: #3f6f5a;
    font-size: 22rpx;
    margin-right: 10rpx;
    margin-bottom: 10rpx;
}

.tag-warm {
    background: #fff3d6;
    color: #9a6b1f;
}

.tag-clay {
    background: #f6e3d8;
    color: #9a4d31;
}

.media-frame {
    position: relative;
    overflow: hidden;
    min-height: 220rpx;
    border-radius: 16rpx;
    background: #eadfce;
    border: 1rpx solid rgba(63, 111, 90, 0.18);
}

.media-frame::before {
    content: "";
    position: absolute;
    inset: 0;
    background:
        linear-gradient(135deg, rgba(63, 111, 90, 0.18), rgba(184, 100, 60, 0.08)),
        radial-gradient(circle at 18% 24%, rgba(255, 252, 247, 0.78), transparent 30%),
        radial-gradient(circle at 78% 70%, rgba(217, 164, 65, 0.22), transparent 32%);
}

.media-label {
    position: absolute;
    left: 24rpx;
    bottom: 22rpx;
    padding: 10rpx 16rpx;
    border-radius: 999rpx;
    background: rgba(255, 252, 247, 0.86);
    color: #3f4c42;
    font-size: 22rpx;
}

.muted {
    color: #6f746f;
}

.price {
    color: #b8643c;
    font-size: 34rpx;
    font-weight: 800;
}

.bottom-action {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    gap: 18rpx;
    align-items: center;
    padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
    background: rgba(255, 252, 247, 0.96);
    border-top: 1rpx solid #e7ded2;
    z-index: 20;
}

.bottom-action .summary {
    flex: 1;
}
