<view class="page custom-page">
    <view class="custom-hero">
        <image class="custom-hero-image" src="/assets/visuals/custom-overview.jpg" mode="aspectFill"></image>
        <view class="custom-hero-copy">
            <text class="title">定制一件专属作品</text>
            <text class="copy">先看材料气质，再填写用途、预算和风格。正式版会接入图片上传、报价和制作进度。</text>
        </view>
    </view>

    <view class="section">
        <view class="section-title">
            <text class="section-title-main">选择手作主题</text>
            <text class="section-title-sub">二级入口</text>
        </view>
        <view class="theme-list">
            <view wx:for="{{options.categories}}" wx:key="name" class="theme-card {{form.category === item.name ? 'active' : ''}}" data-name="{{item.name}}" bindtap="chooseCategory">
                <image class="theme-image" src="{{item.image}}" mode="aspectFill"></image>
                <view class="theme-copy">
                    <text class="theme-title">{{item.name}}</text>
                    <text class="theme-summary">{{item.summary}}</text>
                </view>
            </view>
        </view>
    </view>

    <view class="section selected-panel card">
        <text class="block-title">当前主题：{{selectedCategory.name}}</text>
        <text class="copy">{{selectedCategory.summary}}。下一步填写用途和预算，店员会按主题准备材料与报价。</text>
    </view>

    <view class="section card form-card">
        <text class="block-title">用途</text>
        <view class="option-grid">
            <view wx:for="{{options.purposes}}" wx:key="*this" class="option {{form.purpose === item ? 'active' : ''}}" data-field="purpose" data-value="{{item}}" bindtap="choose">{{item}}</view>
        </view>
    </view>

    <view class="section card form-card">
        <text class="block-title">预算</text>
        <view class="option-grid">
            <view wx:for="{{options.budgets}}" wx:key="*this" class="option {{form.budget === item ? 'active' : ''}}" data-field="budget" data-value="{{item}}" bindtap="choose">{{item}}</view>
        </view>
    </view>

    <view class="section card form-card">
        <text class="block-title">风格</text>
        <view class="option-grid">
            <view wx:for="{{options.styles}}" wx:key="*this" class="option {{form.style === item ? 'active' : ''}}" data-field="style" data-value="{{item}}" bindtap="choose">{{item}}</view>
        </view>
    </view>

    <view class="section card upload-card">
        <text class="block-title">参考图</text>
        <view class="upload-row">
            <view class="upload-box">+</view>
            <view class="upload-box">+</view>
            <view class="upload-box">+</view>
        </view>
        <text class="muted">静态 Demo 仅展示上传入口，正式版接入图片上传和校验。</text>
    </view>

    <button class="primary-button submit-button" bindtap="submitDemo">提交需求</button>
</view>
