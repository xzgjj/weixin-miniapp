.custom-hero {
    position: relative;
    min-height: 620rpx;
    overflow: hidden;
    border-radius: 28rpx;
    background: #eadfce;
}

.custom-hero-image {
    width: 100%;
    height: 620rpx;
    display: block;
}

.custom-hero::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(255, 252, 247, 0.08), rgba(31, 36, 32, 0.58));
}

.custom-hero-copy {
    position: absolute;
    left: 30rpx;
    right: 30rpx;
    bottom: 32rpx;
    z-index: 1;
}

.form-card,
.upload-card,
.selected-panel {
    padding: 28rpx;
}

.title {
    display: block;
    color: #fffdf8;
    font-size: 44rpx;
    font-weight: 800;
    margin-bottom: 12rpx;
}

.copy {
    display: block;
    color: #4f594f;
    font-size: 28rpx;
    line-height: 1.7;
}

.custom-hero-copy .copy {
    color: #fffdf8;
}

.block-title {
    display: block;
    font-size: 32rpx;
    font-weight: 800;
    margin-bottom: 18rpx;
}

.option-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 14rpx;
}

.theme-list {
    display: flex;
    flex-direction: column;
    gap: 18rpx;
}

.theme-card {
    position: relative;
    min-height: 260rpx;
    overflow: hidden;
    border-radius: 24rpx;
    border: 2rpx solid transparent;
    background: #1f2420;
}

.theme-card.active {
    border-color: #3f6f5a;
}

.theme-image {
    width: 100%;
    height: 260rpx;
    display: block;
}

.theme-card::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(31, 36, 32, 0.68), rgba(31, 36, 32, 0.08));
}

.theme-copy {
    position: absolute;
    left: 24rpx;
    right: 24rpx;
    bottom: 24rpx;
    z-index: 1;
}

.theme-title {
    display: block;
    color: #fffdf8;
    font-size: 38rpx;
    font-weight: 850;
}

.theme-summary {
    display: block;
    color: rgba(255, 253, 248, 0.88);
    font-size: 24rpx;
    margin-top: 8rpx;
}

.option {
    min-height: 76rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 999rpx;
    background: #fff8ea;
    border: 1rpx solid #eadbc2;
    color: #4f594f;
    font-weight: 700;
}

.option.active {
    background: #3f6f5a;
    color: #ffffff;
    border-color: #3f6f5a;
}

.upload-row {
    display: flex;
    gap: 16rpx;
    margin-bottom: 18rpx;
}

.upload-box {
    width: 150rpx;
    height: 150rpx;
    border-radius: 16rpx;
    background: #f3eadc;
    color: #b8643c;
    font-size: 54rpx;
    display: flex;
    align-items: center;
    justify-content: center;
}

.submit-button {
    width: 100%;
    margin-top: 32rpx;
}
