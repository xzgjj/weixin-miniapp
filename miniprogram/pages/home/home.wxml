<view class="page home-page">
    <view class="hero">
        <image class="hero-image" src="{{home.visuals.hero}}" mode="aspectFill"></image>
        <view class="hero-content">
            <text class="eyebrow">{{home.brandName}}</text>
            <text class="hero-title">{{home.headline}}</text>
            <text class="hero-subtitle">{{home.subtitle}}</text>
            <view class="hero-actions">
                <button class="primary-button" bindtap="goCustom">开始定制</button>
                <button class="secondary-button" bindtap="goProduct">逛逛成品</button>
            </view>
        </view>
    </view>

    <view class="section">
        <view class="section-title">
            <text class="section-title-main">品牌空间</text>
            <text class="section-title-sub">先感受店里</text>
        </view>
        <view class="brand-card card">
            <image class="brand-image" src="{{home.visuals.store}}" mode="aspectFill"></image>
            <view class="brand-copy">
                <text class="brand-title">创建心动</text>
                <text class="brand-text">坐下来，选一件材料，慢慢做成自己的作品。</text>
            </view>
        </view>
    </view>

    <view class="section address-card card">
        <view>
            <text class="store-title">{{home.store.name}}</text>
            <text class="muted">{{home.store.address}}</text>
            <text class="muted">{{home.store.hours}}</text>
        </view>
        <button class="secondary-button address-button" bindtap="goOrders">我的预约</button>
    </view>
</view>
