.home-page {
    padding-top: 18rpx;
}

.hero {
    position: relative;
    min-height: 700rpx;
    overflow: hidden;
    border-radius: 28rpx;
    background: #eadfce;
}

.hero-image {
    width: 100%;
    height: 700rpx;
    display: block;
}

.hero::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
        linear-gradient(180deg, rgba(255, 252, 247, 0.1), rgba(31, 36, 32, 0.52)),
        linear-gradient(90deg, rgba(255, 252, 247, 0.7), rgba(255, 252, 247, 0.08) 60%);
}

.hero-content {
    position: absolute;
    left: 34rpx;
    right: 34rpx;
    bottom: 38rpx;
    z-index: 1;
}

.eyebrow {
    display: block;
    color: #3f6f5a;
    font-size: 25rpx;
    font-weight: 800;
    margin-bottom: 12rpx;
}

.hero-title {
    display: block;
    max-width: 560rpx;
    color: #1f2420;
    font-size: 48rpx;
    font-weight: 900;
    line-height: 1.16;
}

.hero-subtitle {
    display: block;
    color: #3f4c42;
    font-size: 25rpx;
    margin-top: 18rpx;
}

.hero-actions {
    display: flex;
    gap: 18rpx;
    margin-top: 30rpx;
}

.hero-actions button {
    flex: 1;
}

.brand-card {
    overflow: hidden;
}

.brand-image {
    width: 100%;
    height: 340rpx;
    display: block;
}

.brand-copy {
    padding: 28rpx;
}

.brand-title,
.store-title {
    display: block;
    color: #1f2420;
    font-size: 32rpx;
    font-weight: 850;
    line-height: 1.32;
}

.brand-text {
    display: block;
    color: #59635b;
    font-size: 26rpx;
    line-height: 1.7;
    margin-top: 12rpx;
}

.address-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20rpx;
    padding: 28rpx;
}

.address-card .muted {
    display: block;
    margin-top: 8rpx;
    line-height: 1.45;
}

.address-button {
    min-width: 190rpx;
    min-height: 72rpx;
    padding: 0 24rpx;
    font-size: 25rpx;
}
