<view class="page orders-page">
    <view class="member-card card">
        <view>
            <text class="member-name">{{account.loggedIn ? account.nickname : '登录后查看会员权益'}}</text>
            <text class="member-sub">{{account.loggedIn ? '手作学徒 · 欢迎回来' : '支持微信登录或手机号授权登录'}}</text>
        </view>
        <view class="login-actions">
            <button class="primary-button login-button" bindtap="loginWithWechat">微信登录</button>
            <button class="secondary-button login-button" open-type="getPhoneNumber" bindgetphonenumber="handlePhoneLogin">手机号登录</button>
        </view>
    </view>

    <view class="panel-card card">
        <text class="panel-title">我的资产</text>
        <view class="asset-grid">
            <view wx:for="{{assets}}" wx:key="name" class="asset-item" data-name="{{item.name}}" bindtap="handlePanelAction">
                <text class="asset-icon">{{item.icon}}</text>
                <text class="asset-name">{{item.name}}</text>
                <text class="asset-desc">{{item.desc}}</text>
            </view>
        </view>
    </view>

    <view class="panel-card card">
        <text class="panel-title">我的功能</text>
        <view class="function-grid">
            <view wx:for="{{functions}}" wx:key="name" class="function-item" data-name="{{item.name}}" bindtap="handlePanelAction">
                <text class="function-icon">{{item.icon}}</text>
                <text class="function-name">{{item.name}}</text>
            </view>
        </view>
    </view>

    <view class="section">
        <view class="section-title">
            <text class="section-title-main">我的记录</text>
            <text class="section-title-sub">预约 / 商品 / 定制</text>
        </view>
        <view wx:for="{{orders}}" wx:key="id" class="order-card card">
            <view class="order-head">
                <text class="tag tag-clay">{{item.type}}</text>
                <text class="status">{{item.status}}</text>
            </view>
            <text class="order-title">{{item.title}}</text>
            <text class="muted">{{item.time}}</text>
            <view class="order-foot">
                <text class="price">{{item.amount}}</text>
                <button class="secondary-button mini-button" data-action="{{item.action}}" bindtap="handleOrderAction">{{item.action}}</button>
            </view>
        </view>
    </view>
</view>
