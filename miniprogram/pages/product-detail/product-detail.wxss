.product-detail-page {
    padding-bottom: 56rpx;
    background: #fbfaf7;
}

.shop-head {
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    min-height: 112rpx;
}

.shop-title {
    color: #1f2420;
    font-size: 46rpx;
    font-weight: 900;
}

.cart-button {
    position: absolute;
    right: 0;
    top: 18rpx;
    width: 88rpx;
    height: 72rpx;
    min-height: 72rpx;
    padding: 0;
    border-radius: 999rpx;
    background: #3f6f5a;
    color: #fffdf8;
    font-size: 28rpx;
    font-weight: 850;
}

.cart-badge {
    position: absolute;
    right: -4rpx;
    top: -8rpx;
    min-width: 34rpx;
    height: 34rpx;
    padding: 0 8rpx;
    border-radius: 999rpx;
    background: #b8643c;
    color: #fffdf8;
    font-size: 20rpx;
    line-height: 34rpx;
}

.inspire-button {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 560rpx;
    min-height: 96rpx;
    margin: 18rpx auto 78rpx;
    border-radius: 999rpx;
    background: #1f2420;
    color: #fffdf8;
    font-size: 32rpx;
    font-weight: 900;
}

.centered-title {
    justify-content: center;
    margin-bottom: 38rpx;
}

.centered-title .section-title-main {
    font-size: 42rpx;
    font-weight: 900;
}

.shop-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 22rpx;
}

.shop-card {
    overflow: hidden;
    border-radius: 18rpx;
    background: #ffffff;
    border: 1rpx solid #f0eee9;
}

.shop-thumb {
    min-height: 260rpx;
    display: flex;
    align-items: flex-end;
    padding: 18rpx;
    background:
        linear-gradient(135deg, rgba(63, 111, 90, 0.18), rgba(184, 100, 60, 0.1)),
        #f3efe6;
    color: #59635b;
    font-size: 22rpx;
    line-height: 1.35;
}

.shop-card-body {
    padding: 22rpx;
}

.shop-card-title {
    display: block;
    min-height: 76rpx;
    color: #1f2420;
    font-size: 29rpx;
    font-weight: 900;
    line-height: 1.3;
}

.shop-card-desc {
    display: block;
    min-height: 66rpx;
    color: #8a877f;
    font-size: 23rpx;
    line-height: 1.42;
    margin-top: 8rpx;
}

.shop-card-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12rpx;
    margin-top: 18rpx;
}

.shop-card-price {
    color: #1f2420;
    font-size: 30rpx;
    font-weight: 900;
}

.bag-button {
    width: 72rpx;
    height: 72rpx;
    min-height: 72rpx;
    padding: 0;
    border-radius: 999rpx;
    background: #3f6f5a;
    color: #fffdf8;
    font-size: 22rpx;
    font-weight: 850;
}

.sheet-mask {
    position: fixed;
    inset: 0;
    background: rgba(31, 36, 32, 0.38);
    z-index: 50;
}

.sku-sheet,
.cart-sheet {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 51;
    max-height: 86vh;
    overflow-y: auto;
    padding: 18rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
    border-radius: 32rpx 32rpx 0 0;
    background: #fffcf7;
    box-shadow: 0 -20rpx 60rpx rgba(31, 36, 32, 0.16);
}

.sheet-handle {
    width: 86rpx;
    height: 8rpx;
    margin: 0 auto 22rpx;
    border-radius: 999rpx;
    background: #d7cdbc;
}

.sheet-head,
.cart-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 20rpx;
}

.sheet-close {
    width: 64rpx;
    height: 64rpx;
    min-height: 64rpx;
    padding: 0;
    background: #f3eadc;
    color: #4f594f;
    font-size: 44rpx;
}

.product-title,
.cart-title {
    display: block;
    font-size: 40rpx;
    font-weight: 900;
    line-height: 1.24;
    margin-bottom: 12rpx;
}

.copy {
    display: block;
    color: #4f594f;
    font-size: 27rpx;
    line-height: 1.7;
    margin-top: 16rpx;
}

.sheet-block {
    margin-top: 28rpx;
}

.block-title {
    display: block;
    font-size: 31rpx;
    font-weight: 850;
    margin-bottom: 18rpx;
}

.sku-list {
    display: flex;
    flex-wrap: wrap;
    gap: 14rpx;
}

.sku-pill {
    min-height: 72rpx;
    display: flex;
    align-items: center;
    padding: 0 24rpx;
    border-radius: 999rpx;
    background: #fff8ea;
    border: 1rpx solid #eadbc2;
    color: #4f594f;
}

.sku-pill.active {
    background: #3f6f5a;
    color: #ffffff;
    border-color: #3f6f5a;
}

.quantity-row,
.cart-item-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.quantity-row .block-title {
    margin-bottom: 0;
}

.stepper {
    display: flex;
    align-items: center;
    gap: 22rpx;
}

.stepper button {
    width: 64rpx;
    height: 64rpx;
    min-height: 64rpx;
    padding: 0;
    background: #edf3ee;
    color: #3f6f5a;
    font-size: 36rpx;
    font-weight: 850;
}

.stepper text {
    min-width: 40rpx;
    text-align: center;
    font-size: 32rpx;
    font-weight: 850;
}

.sheet-actions {
    display: flex;
    gap: 18rpx;
    margin-top: 30rpx;
}

.sheet-actions button {
    flex: 1;
}

.delivery-row {
    display: flex;
    justify-content: space-between;
    gap: 16rpx;
    padding: 18rpx 0 24rpx;
    color: #8a877f;
    font-size: 24rpx;
    border-bottom: 1rpx solid #efe7dc;
}

.empty-cart {
    display: flex;
    flex-direction: column;
    gap: 10rpx;
    align-items: center;
    justify-content: center;
    min-height: 220rpx;
    color: #8a877f;
}

.cart-item {
    display: flex;
    gap: 22rpx;
    padding: 28rpx 0;
    border-bottom: 1rpx solid #efe7dc;
}

.cart-thumb {
    width: 150rpx;
    height: 150rpx;
    display: flex;
    align-items: flex-end;
    padding: 14rpx;
    border-radius: 18rpx;
    background:
        linear-gradient(135deg, rgba(63, 111, 90, 0.16), rgba(184, 100, 60, 0.1)),
        #f3efe6;
    color: #59635b;
    font-size: 20rpx;
    line-height: 1.3;
}

.cart-info {
    flex: 1;
}

.cart-item-title {
    display: block;
    color: #1f2420;
    font-size: 30rpx;
    font-weight: 900;
    margin-bottom: 8rpx;
}

.quantity {
    color: #4f594f;
    font-weight: 850;
}

.checkout-button {
    width: 100%;
    margin-top: 26rpx;
}
