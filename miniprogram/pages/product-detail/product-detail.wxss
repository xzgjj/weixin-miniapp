.product-detail-page {
    padding-bottom: 160rpx;
}

.product-hero {
    min-height: 560rpx;
}

.product-info,
.sku-card,
.info-card {
    padding: 28rpx;
}

.product-title {
    display: block;
    font-size: 44rpx;
    font-weight: 800;
    line-height: 1.2;
    margin-bottom: 16rpx;
}

.tag-line {
    margin-top: 18rpx;
}

.copy {
    display: block;
    color: #4f594f;
    font-size: 28rpx;
    line-height: 1.7;
    margin-top: 16rpx;
}

.block-title {
    display: block;
    font-size: 32rpx;
    font-weight: 800;
    margin-bottom: 18rpx;
}

.sku-list {
    display: flex;
    flex-wrap: wrap;
    gap: 14rpx;
}

.sku-pill {
    min-height: 72rpx;
    display: flex;
    align-items: center;
    padding: 0 24rpx;
    border-radius: 999rpx;
    background: #fff8ea;
    border: 1rpx solid #eadbc2;
    color: #4f594f;
}

.sku-pill.active {
    background: #3f6f5a;
    color: #ffffff;
    border-color: #3f6f5a;
}

.summary-main {
    display: block;
    font-size: 28rpx;
    font-weight: 800;
}
