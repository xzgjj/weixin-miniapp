.product-detail-page {
    padding-bottom: 56rpx;
}

.shop-hero {
    position: relative;
    min-height: 360rpx;
    overflow: hidden;
    border-radius: 28rpx;
    background: #eadfce;
}

.shop-hero-image {
    width: 100%;
    height: 360rpx;
    display: block;
}

.shop-hero::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(255, 252, 247, 0.05), rgba(31, 36, 32, 0.55));
}

.shop-hero-copy {
    position: absolute;
    left: 28rpx;
    right: 28rpx;
    bottom: 30rpx;
    z-index: 1;
}

.shop-kicker {
    display: block;
    color: #d9eadf;
    font-size: 24rpx;
    font-weight: 800;
    margin-bottom: 8rpx;
}

.shop-title {
    display: block;
    color: #fffdf8;
    font-size: 46rpx;
    font-weight: 900;
}

.shop-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 18rpx;
}

.shop-card {
    overflow: hidden;
    border-radius: 18rpx;
    background: #fffcf7;
    border: 1rpx solid #e7ded2;
}

.shop-thumb {
    min-height: 190rpx;
    display: flex;
    align-items: flex-end;
    padding: 18rpx;
    background:
        linear-gradient(135deg, rgba(63, 111, 90, 0.2), rgba(184, 100, 60, 0.12)),
        #eadfce;
    color: #3f4c42;
    font-size: 22rpx;
    line-height: 1.35;
}

.shop-card-body {
    padding: 18rpx;
}

.shop-card-title {
    display: block;
    min-height: 72rpx;
    color: #1f2420;
    font-size: 27rpx;
    font-weight: 850;
    line-height: 1.35;
}

.shop-card-price {
    display: block;
    color: #b8643c;
    font-size: 28rpx;
    font-weight: 850;
    margin-top: 8rpx;
}

.shop-card-action {
    display: inline-flex;
    align-items: center;
    height: 46rpx;
    padding: 0 16rpx;
    margin-top: 14rpx;
    border-radius: 999rpx;
    background: #edf3ee;
    color: #3f6f5a;
    font-size: 22rpx;
    font-weight: 800;
}

.cart-strip {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 24rpx 28rpx;
    margin-top: 28rpx;
}

.cart-count {
    color: #3f6f5a;
    font-weight: 850;
}

.sheet-mask {
    position: fixed;
    inset: 0;
    background: rgba(31, 36, 32, 0.38);
    z-index: 50;
}

.sku-sheet {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 51;
    padding: 18rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
    border-radius: 32rpx 32rpx 0 0;
    background: #fffcf7;
    box-shadow: 0 -20rpx 60rpx rgba(31, 36, 32, 0.16);
}

.sheet-handle {
    width: 86rpx;
    height: 8rpx;
    margin: 0 auto 22rpx;
    border-radius: 999rpx;
    background: #d7cdbc;
}

.sheet-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 20rpx;
}

.sheet-close {
    width: 64rpx;
    height: 64rpx;
    min-height: 64rpx;
    padding: 0;
    background: #f3eadc;
    color: #4f594f;
    font-size: 44rpx;
}

.product-title {
    display: block;
    font-size: 40rpx;
    font-weight: 900;
    line-height: 1.24;
    margin-bottom: 12rpx;
}

.copy {
    display: block;
    color: #4f594f;
    font-size: 27rpx;
    line-height: 1.7;
    margin-top: 16rpx;
}

.sheet-block {
    margin-top: 28rpx;
}

.block-title {
    display: block;
    font-size: 31rpx;
    font-weight: 850;
    margin-bottom: 18rpx;
}

.sku-list {
    display: flex;
    flex-wrap: wrap;
    gap: 14rpx;
}

.sku-pill {
    min-height: 72rpx;
    display: flex;
    align-items: center;
    padding: 0 24rpx;
    border-radius: 999rpx;
    background: #fff8ea;
    border: 1rpx solid #eadbc2;
    color: #4f594f;
}

.sku-pill.active {
    background: #3f6f5a;
    color: #ffffff;
    border-color: #3f6f5a;
}

.quantity-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.quantity-row .block-title {
    margin-bottom: 0;
}

.stepper {
    display: flex;
    align-items: center;
    gap: 22rpx;
}

.stepper button {
    width: 64rpx;
    height: 64rpx;
    min-height: 64rpx;
    padding: 0;
    background: #edf3ee;
    color: #3f6f5a;
    font-size: 36rpx;
    font-weight: 850;
}

.stepper text {
    min-width: 40rpx;
    text-align: center;
    font-size: 32rpx;
    font-weight: 850;
}

.sheet-actions {
    display: flex;
    gap: 18rpx;
    margin-top: 30rpx;
}

.sheet-actions button {
    flex: 1;
}
